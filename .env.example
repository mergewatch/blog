# Empty mounts at the domain root; /blog mounts below the main product site.
NEXT_PUBLIC_BASE_PATH=/blog
# Only the exact value "production" permits indexing and excludes drafts.
DEPLOYMENT_ENV=development
# Local development only: opt in to rendering draft content.
NEXT_PUBLIC_SHOW_DRAFTS=false
# Optional, disabled unless explicitly configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
